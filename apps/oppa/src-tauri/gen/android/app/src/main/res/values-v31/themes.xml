<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.oppa" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/oppa_background</item>
        <item name="colorPrimary">@color/oppa_primary</item>
    </style>

    <!-- Android 12+ system splash screen: the adaptive OPPA mark on the brand tile color. -->
    <style name="Theme.oppa.Launch">
        <item name="android:windowSplashScreenBackground">@color/oppa_brand</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/oppa_brand</item>
        <item name="android:windowBackground">@color/oppa_brand</item>
    </style>
</resources>
