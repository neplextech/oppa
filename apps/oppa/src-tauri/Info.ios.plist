<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by the Tauri CLI into the generated iOS Info.plist.

  OPPA prints to raw TCP printers on the local network and finds them with
  Bonjour, both of which require local network privacy consent. No background
  modes are declared: iOS keeps OPPA connected only while it is active, and
  bounded background tasks need no entitlement.
-->
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>OPPA connects to printers on your local network to print jobs sent by your OpenPrinter server.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pdl-datastream._tcp</string>
		<string>_ipp._tcp</string>
		<string>_printer._tcp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
