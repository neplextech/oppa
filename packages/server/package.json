{
  "name": "@openprinter/server",
  "version": "0.3.0",
  "description": "Transport-neutral protocol session SDK for OpenPrinter-compatible agents",
  "homepage": "https://oppa.neplex.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neplextech/oppa.git",
    "directory": "packages/server"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm --filter @openprinter/protocol build && pnpm run typecheck && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@openprinter/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
